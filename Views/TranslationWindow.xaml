<Window x:Class="ScreenTranslator.Views.TranslationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Screen Translator" 
        SizeToContent="WidthAndHeight"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="True" 
        ShowInTaskbar="False">
    <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4" Padding="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Header for dragging -->
            <Grid Grid.Row="0" Margin="0,0,0,10" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                <TextBlock x:Name="TxtHeader" Text="🤖 AI解説" Foreground="#AAAAAA" FontSize="12" FontWeight="Bold" HorizontalAlignment="Left"/>
                <Button Content="✕" Width="20" Height="20" HorizontalAlignment="Right" VerticalAlignment="Top" 
                        Background="Transparent" Foreground="#AAAAAA" BorderThickness="0" 
                        Click="CloseButton_Click" Cursor="Hand"/>
            </Grid>
            
            <StackPanel Grid.Row="1">
                <!-- Original Text Section -->
                <Border x:Name="OriginalSection" Background="#1E1E1E" CornerRadius="4" Padding="8" Margin="0,0,0,10">
                    <TextBlock x:Name="TxtOriginal" Foreground="#D4D4D4" TextWrapping="Wrap" FontSize="12"/>
                </Border>
                
                <!-- Translated/Explained Text Section -->
                <ScrollViewer x:Name="ScrollTranslation" VerticalScrollBarVisibility="Auto">
                    <TextBlock x:Name="TxtTranslation" Foreground="#4EC9B0" TextWrapping="Wrap" FontSize="14" FontWeight="Bold"/>
                </ScrollViewer>
            </StackPanel>
            
            <!-- Resize Thumb (Bottom Right) -->
            <Thumb Grid.Row="1" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" 
                   Cursor="SizeNWSE" DragDelta="ResizeThumb_DragDelta" Margin="0,0,-8,-8">
                <Thumb.Template>
                    <ControlTemplate>
                        <Grid Background="Transparent">
                            <Path Data="M 0 10 L 10 0 L 10 10 Z" Fill="#555555" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                        </Grid>
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
        </Grid>
    </Border>
</Window>
